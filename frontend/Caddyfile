{$DOMAIN} {
    # API requests go to the backend first
    handle /api/* {
        reverse_proxy backend:3001
    }

    # Everything else: a real file, then a static directory's index.html
    # (e.g. /word-lock/privacy), then the React SPA as the fallback
    handle {
        root * /srv
        try_files {path} {path}/index.html /index.html
        file_server
    }
}
